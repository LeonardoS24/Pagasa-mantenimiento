DATABASE_URL="file:./dev.db"
SESSION_SECRET="reemplazar-con-una-cadena-aleatoria-de-al-menos-32-caracteres"

# Poner en "true" SOLO cuando el sistema se sirva por https. Marca la cookie
# de sesión como "secure", y una cookie secure NO viaja por http: si se
# prende sirviendo por http (por ejemplo en la red local,
# http://192.168.x.x:3000), nadie podrá iniciar sesión.
COOKIE_SECURE=false
