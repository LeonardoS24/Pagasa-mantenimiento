DATABASE_URL="file:./dev.db"
SESSION_SECRET="reemplazar-con-una-cadena-aleatoria-de-al-menos-32-caracteres"

# Marca la cookie de sesión como "secure" (solo viaja por https). NO hace
# falta tocarlo: scripts/servidor.mjs lo prende solo cuando hay certificados
# (ver servidor-activar-https.bat). Si se prende a mano sirviendo por http
# (http://192.168.x.x:3000), nadie podrá iniciar sesión.
COOKIE_SECURE=false

# ACCESO POR INTERNET con el túnel de Cloudflare (ver ACCESO-POR-INTERNET.md).
# Solo se prende cuando cloudflared corre en ESTA computadora: entonces el
# sistema cree en la IP real y en el https que le entrega el túnel (y solo si la
# petición viene de este mismo equipo). Sin túnel, déjalo comentado.
# CONFIAR_TUNEL=cloudflare

# Exige la doble verificación (código de 6 dígitos en el teléfono) a todos los
# administradores: mientras no la activen, solo pueden entrar a la pantalla para
# activarla. Recomendado antes de abrir el sistema a internet.
# EXIGIR_2FA_ADMIN=true

# OPCIONAL y de paga. Activa la lectura automática de documentos escaneados
# (ver "Carga de documentos escaneados" en CLAUDE.md): sin esta clave el lote
# se divide a mano y no cuesta nada. Requiere salida a internet hacia
# api.anthropic.com.
# ANTHROPIC_API_KEY=
