DATABASE_URL="file:./dev.db"
SESSION_SECRET="reemplazar-con-una-cadena-aleatoria-de-al-menos-32-caracteres"

# Marca la cookie de sesión como "secure" (solo viaja por https). NO hace
# falta tocarlo: scripts/servidor.mjs lo prende solo cuando hay certificados
# (ver servidor-activar-https.bat). Si se prende a mano sirviendo por http
# (http://192.168.x.x:3000), nadie podrá iniciar sesión.
COOKIE_SECURE=false

# OPCIONAL y de paga. Activa la lectura automática de documentos escaneados
# (ver "Carga de documentos escaneados" en CLAUDE.md): sin esta clave el lote
# se divide a mano y no cuesta nada. Requiere salida a internet hacia
# api.anthropic.com.
# ANTHROPIC_API_KEY=
