generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite no soporta enums nativos en Prisma; el rol se valida a nivel de
// aplicación con zod (ver lib/roles.ts) y se guarda como texto
// ("ADMIN" | "USUARIO" | "LECTOR"). ADMIN administra todo; USUARIO puede
// agregar/editar números económicos, fichas técnicas, bitácoras y archivos
// pero no crear/eliminar ciudades ni apartados, ni renombrar nada existente;
// LECTOR solo puede ver (equivalente al antiguo comportamiento de USUARIO).
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("USUARIO")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Todas estas relaciones usan onDelete: SetNull, nunca Cascade: eliminar a
  // un empleado no debe borrar el historial de mantenimiento de la flota. El
  // registro se conserva y solo pierde el nombre de quien lo capturó.
  cityAccess      UserCityAccess[]
  documents       Document[]
  maintenanceLogs               MaintenanceLog[]
  ultrasoundLogs                UltrasoundLog[]
  visualInspectionLogs          VisualInspectionLog[]
  tightnessTestLogs             TightnessTestLog[]
  internalVisualInspectionLogs  InternalVisualInspectionLog[]
  hydrostaticTestLogs           HydrostaticTestLog[]
  extinguisherChangeLogs        ExtinguisherChangeLog[]
  valveChangeLogs               ValveChangeLog[]
  valveCorrectiveMaintenanceLogs ValveCorrectiveMaintenanceLog[]
  hoseChangeLogs                 HoseChangeLog[]
  pieceOrders                   PieceOrder[]
  inventoryItems                InventoryItem[]

  @@map("users")
}

model City {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections   Section[]
  userAccess UserCityAccess[]

  @@map("cities")
}

model Section {
  id    String @id @default(cuid())
  name  String
  slug  String
  order Int    @default(0)

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Section?  @relation("SectionToSection", fields: [parentId], references: [id], onDelete: Cascade)
  children Section[] @relation("SectionToSection")

  vehicleRecords VehicleRecord[]
  documents      Document[]
  pieceOrders    PieceOrder[]
  inventoryItems InventoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cityId, parentId, slug])
  @@map("sections")
}

// Registros de unidades (autotanques, vehículos, etc.) que se muestran como
// tabla dentro de un apartado de "Unidad de distribución". El campo anterior
// guarda el número económico o la localidad anterior de la unidad, cuando aplica.
model VehicleRecord {
  id    String @id @default(cuid())
  order Int    @default(0)

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  numeroEconomico   String
  sucursal          String
  anio              String
  placas            String
  numeroAnterior    String?
  localidadAnterior String?

  // Dar de baja no elimina la unidad: se conserva en el sistema (con toda su
  // ficha técnica, bitácora y documentos) marcada como inactiva. Solo un
  // ADMIN puede cambiar este estatus.
  activo    Boolean   @default(true)
  fechaBaja DateTime?

  documents                    Document[]
  technicalSheet               VehicleTechnicalSheet?
  maintenanceLogs              MaintenanceLog[]
  ultrasoundLogs               UltrasoundLog[]
  visualInspectionLogs         VisualInspectionLog[]
  tightnessTestLogs            TightnessTestLog[]
  internalVisualInspectionLogs InternalVisualInspectionLog[]
  hydrostaticTestLogs          HydrostaticTestLog[]
  extinguisherChangeLogs       ExtinguisherChangeLog[]
  valveChangeLogs              ValveChangeLog[]
  valveCorrectiveMaintenanceLogs ValveCorrectiveMaintenanceLog[]
  hoseChangeLogs                HoseChangeLog[]
  // Piezas de inventario (de cualquier ciudad) que se marcaron "Utilizada" en
  // esta unidad (ver actions/inventory-actions.ts). No es lo mismo que
  // "documents"/"maintenanceLogs": es solo trazabilidad de dónde se colocó
  // cada pieza.
  inventoryItemsColocados       InventoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicle_records")
}

// Ficha técnica vehicular: datos del automóvil y, si aplica, del tanque de
// gas LP que transporta. Relación 1:1 opcional con VehicleRecord (no todos
// los vehículos la tienen llenada de inmediato).
model VehicleTechnicalSheet {
  id String @id @default(cuid())

  vehicleRecordId String        @unique
  vehicleRecord   VehicleRecord @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)

  // Automóvil
  fabricante        String?
  marca             String?
  linea             String?
  modelo            String?
  peso              String?
  // Solo para Vehículo de reparto y Vehículo con tanque de carburación:
  // reemplazan a "peso" en el formulario (ver useDeliveryFormat).
  pesoBrutoVacio    String?
  pesoBrutoMaximo   String?
  serie             String?
  combustible       String? // "GAS_LP" | "GASOLINA" | "DIESEL" | "ELECTRICA"
  caracteristicas   String?
  ubicacion         String?
  potencia          String?
  horasUsoDiario    String?
  fechaAdquisicion  DateTime?

  // Tanque
  capacidadTanque       String?
  marcaTanque           String?
  anioFabricacionTanque String?
  // Fecha de fabricación real (a diferencia de anioFabricacionTanque, texto
  // libre): ancla el cálculo automático de la inspección visual interna y la
  // prueba hidrostática, que vencen cada 10 años a partir de esta fecha.
  fechaFabricacionTanque DateTime?
  numeroSerieTanque     String?
  numeroUltimoUltrasonido String?
  ultimoUltrasonido     DateTime?
  fechaProximoUltrasonido DateTime?

  // Inspección visual EXTERNA (mismo mecanismo que el ultrasonido, ver VisualInspectionLog)
  numeroUltimaInspeccionVisual String?
  ultimaInspeccionVisual       DateTime?
  fechaProximaInspeccionVisual DateTime?

  // Prueba de hermeticidad (mismo mecanismo, fecha próxima manual, ver TightnessTestLog)
  numeroUltimaPruebaHermeticidad String?
  ultimaPruebaHermeticidad       DateTime?
  fechaProximaPruebaHermeticidad DateTime?

  // Inspección visual INTERNA: vence cada 10 años a partir de
  // fechaFabricacionTanque; fechaProxima se calcula sola si se deja vacía
  // (ver actions/vehicle-actions.ts e internal-visual-inspection-actions.ts).
  numeroUltimaInspeccionVisualInterna String?
  ultimaInspeccionVisualInterna       DateTime?
  fechaProximaInspeccionVisualInterna DateTime?

  // Prueba hidrostática: mismo esquema de 10 años que la inspección visual interna.
  numeroUltimaPruebaHidrostatica String?
  ultimaPruebaHidrostatica       DateTime?
  fechaProximaPruebaHidrostatica DateTime?

  // Extintor: aplica a TODOS los tipos de unidad (no solo Auto-Tanques). La
  // alerta no se basa en fecha próxima sino en la calidad: cuando pasa a
  // "MALA" se guarda fechaCalidadMalaExtintor (primera vez que se detectó);
  // amarilla los primeros 2 días desde esa fecha, roja después. Se limpia si
  // la calidad vuelve a Excelente/Buena (ver actions/vehicle-actions.ts y
  // actions/extinguisher-actions.ts).
  fechaInstalacionExtintor DateTime?
  fechaVencimientoExtintor DateTime?
  calidadExtintor          String? // "EXCELENTE" | "BUENA" | "MALA"
  fechaCalidadMalaExtintor DateTime?

  // Mantenimiento preventivo: se actualiza automáticamente con cada
  // mantenimiento que incluya kilometraje (ver actions/maintenance-actions.ts).
  // El siguiente preventivo se calcula en ese momento como
  // kilometrajeUltimoMantenimiento + 10,000 km y fechaUltimoMantenimiento + 6
  // meses; el aviso (como el de ultrasonido) se evalúa por fecha, que es lo
  // único que se puede verificar sin un kilometraje en vivo — el kilometraje
  // objetivo se muestra como referencia para que el personal lo confirme
  // contra el odómetro real.
  kilometrajeUltimoMantenimiento   Int?
  fechaUltimoMantenimiento         DateTime?
  kilometrajeProximoMantenimiento  Int?
  fechaProximoMantenimiento        DateTime?

  // Cambio de válvulas: solo para Vehículo con tanque de carburación. Cada
  // válvula guarda su propia fecha de fabricación; la alerta (igual que la
  // de ultrasonido) se calcula sobre la más antigua de las 4, venciendo a
  // los 5 años (ver lib/valve-alerts.ts). fechaInstalacionValvulas es la
  // fecha general en que se instaló el juego de válvulas.
  fechaInstalacionValvulas             DateTime?
  fechaFabricacionValvulaLlenado       DateTime?
  fechaFabricacionValvulaServicio      DateTime?
  fechaFabricacionValvulaMaximoLlenado DateTime?
  fechaFabricacionValvulaAlivio        DateTime?

  // Cambio de mangueras: solo para Vehículo con tanque de carburación. La
  // alerta vence a los 2 años (mismo esquema que las válvulas, pero con
  // ciclo más corto) y se calcula sobre fechaFabricacionManguera;
  // fechaInstalacionMangueras es la fecha general en que se instaló la
  // manguera (ver lib/hose-alerts.ts).
  fechaInstalacionMangueras DateTime?
  fechaFabricacionManguera  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicle_technical_sheets")
}

// Entrada de bitácora de mantenimiento de una unidad. El estatus se muestra
// como resumen bajo la ficha técnica del vehículo y también alimenta el feed
// de "Bitácoras de unidades" a nivel ciudad (ordenado por fecha).
model MaintenanceLog {
  id String @id @default(cuid())

  vehicleRecordId String
  vehicleRecord   VehicleRecord @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)

  tipoMantenimiento String
  tipoServicio      String
  pieza             String?
  cantidad          String?
  unidad            String?
  descripcion       String?
  observacion       String?
  fecha             DateTime
  // Kilometraje del odómetro al momento de este mantenimiento. Si viene, se
  // usa para actualizar la ficha técnica y calcular el próximo mantenimiento
  // preventivo (ver actions/maintenance-actions.ts).
  kilometraje       Int?

  nombreOperador             String?
  auxiliarTecnico            String?
  responsableTrabajoMecanico String?

  // "SIN_ATENCION" | "EN_PROCESO" | "TERMINADO" | "CANCELADO"
  estatus String @default("SIN_ATENCION")

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  documents Document[]

  // Piezas de inventario que se colocaron en este mantenimiento.
  piezasUtilizadas InventoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("maintenance_logs")
}

// Registro de cada realización de ultrasonido de tanque (Auto-Tanques). Al
// crearse, actualiza automáticamente ultimoUltrasonido/numeroUltimoUltrasonido
// en la ficha técnica del vehículo (ver actions/ultrasound-actions.ts), de
// modo que la ficha técnica siempre refleje el ultrasonido más reciente
// mientras este registro conserva el historial completo (compañía,
// responsable, documentos) de cada evento.
model UltrasoundLog {
  id String @id @default(cuid())

  vehicleRecordId String
  vehicleRecord   VehicleRecord @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)

  compania          String?
  numeroUltrasonido String?
  responsable       String?

  // Fecha del ultrasonido anterior, capturada como referencia al momento de
  // registrar este nuevo evento.
  fechaUltimoUltrasonido DateTime?
  // Fecha en que se realizó este nuevo ultrasonido (pasa a ser el
  // "ultimoUltrasonido" de la ficha técnica al aceptar el registro).
  fechaRealizacion DateTime

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ultrasound_logs")
}

// Registro de cada realización de inspección visual de tanque (Auto-Tanques).
// Funciona igual que UltrasoundLog: al crearse, actualiza automáticamente
// ultimaInspeccionVisual/numeroUltimaInspeccionVisual en la ficha técnica del
// vehículo (ver actions/visual-inspection-actions.ts).
model VisualInspectionLog {
  id String @id @default(cuid())

  vehicleRecordId String
  vehicleRecord   VehicleRecord @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)

  compania        String?
  numeroInspeccion String?
  responsable     String?

  // Fecha de la inspección visual anterior, capturada como referencia al
  // momento de registrar este nuevo evento.
  fechaUltimaInspeccion DateTime?
  // Fecha en que se realizó esta nueva inspección visual (pasa a ser la
  // "ultimaInspeccionVisual" de la ficha técnica al aceptar el registro).
  fechaRealizacion DateTime

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("visual_inspection_logs")
}

// Registro de cada realización de prueba de hermeticidad de tanque
// (Auto-Tanques). Funciona igual que VisualInspectionLog: fecha próxima
// manual en la ficha técnica, se revisa típicamente cada año.
model TightnessTestLog {
  id String @id @default(cuid())

  vehicleRecordId String
  vehicleRecord   VehicleRecord @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)

  compania    String?
  numeroPrueba String?
  responsable String?

  fechaUltimaPrueba DateTime?
  fechaRealizacion  DateTime

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tightness_test_logs")
}

// Registro de cada realización de inspección visual INTERNA de tanque
// (Auto-Tanques). A diferencia de UltrasoundLog/VisualInspectionLog, al
// aceptarse recalcula fechaProximaInspeccionVisualInterna automáticamente
// como fechaRealizacion + 10 años (ver actions/internal-visual-inspection-actions.ts).
model InternalVisualInspectionLog {
  id String @id @default(cuid())

  vehicleRecordId String
  vehicleRecord   VehicleRecord @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)

  compania         String?
  numeroInspeccion String?
  responsable      String?

  fechaUltimaInspeccion DateTime?
  fechaRealizacion      DateTime

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("internal_visual_inspection_logs")
}

// Registro de cada realización de prueba hidrostática de tanque
// (Auto-Tanques). Mismo esquema de recalculo automático a 10 años que
// InternalVisualInspectionLog.
model HydrostaticTestLog {
  id String @id @default(cuid())

  vehicleRecordId String
  vehicleRecord   VehicleRecord @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)

  compania     String?
  numeroPrueba String?
  responsable  String?

  fechaUltimaPrueba DateTime?
  fechaRealizacion  DateTime

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hydrostatic_test_logs")
}

// Registro de cada cambio/inspección de extintor. Aplica a TODOS los tipos
// de unidad. Al aceptarse actualiza automáticamente fechaInstalacionExtintor,
// fechaVencimientoExtintor y calidadExtintor en la ficha técnica (ver
// actions/extinguisher-actions.ts).
model ExtinguisherChangeLog {
  id String @id @default(cuid())

  vehicleRecordId String
  vehicleRecord   VehicleRecord @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)

  responsable String?

  fechaInstalacion DateTime
  fechaVencimiento DateTime
  calidad          String // "EXCELENTE" | "BUENA" | "MALA"
  fechaRealizacion DateTime

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("extinguisher_change_logs")
}

// Registro de cada cambio de válvulas de tanque. Solo aplica a Vehículo con
// tanque de carburación. Cada una de las 4 válvulas guarda su propia fecha
// de fabricación (usadas para la alerta de 5 años); fechaInstalacion es la
// fecha general en que se instaló el juego completo. Al aceptarse, actualiza
// automáticamente los 5 campos correspondientes en la ficha técnica (ver
// actions/valve-actions.ts).
model ValveChangeLog {
  id String @id @default(cuid())

  vehicleRecordId String
  vehicleRecord   VehicleRecord @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)

  responsable String?

  fechaInstalacion DateTime

  fechaFabricacionValvulaLlenado       DateTime
  fechaFabricacionValvulaServicio      DateTime
  fechaFabricacionValvulaMaximoLlenado DateTime
  fechaFabricacionValvulaAlivio        DateTime

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  documents Document[]

  // Piezas de inventario que se colocaron en este cambio de válvulas.
  piezasUtilizadas InventoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("valve_change_logs")
}

// Registro de mantenimiento CORRECTIVO de válvulas (reparación puntual fuera
// del ciclo preventivo de 5 años de ValveChangeLog). Solo aplica a Vehículo
// con tanque de carburación. No sincroniza nada en la ficha técnica: es solo
// historial de qué se reparó, cuándo y en qué válvula.
model ValveCorrectiveMaintenanceLog {
  id String @id @default(cuid())

  vehicleRecordId String
  vehicleRecord   VehicleRecord @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)

  // "LLENADO" | "SERVICIO" | "MAXIMO_LLENADO" | "ALIVIO" | "GENERAL" (ver lib/valve-alerts.ts)
  valvula     String
  descripcion String
  responsable String?
  fecha       DateTime

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  documents Document[]

  // Piezas de inventario que se colocaron en este mantenimiento correctivo.
  piezasUtilizadas InventoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("valve_corrective_maintenance_logs")
}

// Registro de cada cambio de manguera de tanque de carburación. Solo aplica
// a Vehículo con tanque de carburación. fechaFabricacionManguera ancla la
// alerta de 2 años (mismo esquema que ValveChangeLog pero con ciclo más
// corto y una sola fecha); fechaInstalacion es la fecha general en que se
// instaló. Al
// aceptarse, actualiza automáticamente los 2 campos correspondientes en la
// ficha técnica (ver actions/hose-actions.ts).
model HoseChangeLog {
  id String @id @default(cuid())

  vehicleRecordId String
  vehicleRecord   VehicleRecord @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)

  responsable String?

  fechaInstalacion         DateTime
  fechaFabricacionManguera DateTime

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hose_change_logs")
}

// Orden de una pieza común solicitada para una ciudad, en el apartado "Orden
// de Pieza". Al marcarse como ACEPTADA se crea automáticamente un
// InventoryItem correspondiente en el apartado de Inventarios de la misma
// ciudad (ver actions/piece-order-actions.ts). El registro de la orden
// permanece aquí sin importar su estatus final.
model PieceOrder {
  id String @id @default(cuid())

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  // "REFACCION" | "PIEZA" | "HERRAMIENTA" | "CONSUMIBLE" (ver lib/inventory-enums.ts)
  tipo String
  // Qué se pide en concreto ("Balata delantera", "Aceite 15W40"). Por ahora
  // es texto libre; más adelante puede volverse un catálogo seleccionable.
  nombre String
  // Unidad ya resuelta: "PZA" para los contables, "LTS"/"KG" para consumibles.
  unidad     String
  cantidad   Int
  fechaOrden DateTime

  // "PENDIENTE" | "ACEPTADA" | "RECHAZADA"
  estado String @default("PENDIENTE")

  // Una orden aceptada genera VARIOS renglones de inventario cuando el tipo
  // es contable (5 refacciones -> 5 renglones independientes); el consumible
  // genera uno solo con el total.
  inventoryItems InventoryItem[]

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("piece_orders")
}

// Pieza en inventario, generada automáticamente al aceptar una PieceOrder.
// "POR_UTILIZAR" pasa a "UTILIZADA" automáticamente 5 días después de
// marcarse (barrido en actions/inventory-actions.ts que corre cada vez que
// se visita el apartado de Inventarios de esa ciudad). Una vez "UTILIZADA"
// el registro se conserva pero se muestra al final de la lista, igual que
// al dar de baja una unidad.
model InventoryItem {
  id String @id @default(cuid())

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  pieceOrderId String?
  pieceOrder   PieceOrder? @relation(fields: [pieceOrderId], references: [id], onDelete: SetNull)

  // Mismos campos que la orden que lo generó (ver lib/inventory-enums.ts).
  tipo     String
  nombre   String
  unidad   String
  cantidad Int

  // "EN_INVENTARIO" | "POR_UTILIZAR" | "UTILIZADA"
  estado String @default("EN_INVENTARIO")

  // Unidad en la que se colocó la pieza. Se pide obligatoriamente al marcar
  // "Utilizada" (ver actions/inventory-actions.ts); onDelete SetNull para no
  // perder el historial del inventario si la unidad se elimina después.
  usedOnVehicleId String?
  usedOnVehicle   VehicleRecord? @relation(fields: [usedOnVehicleId], references: [id], onDelete: SetNull)

  // En qué trabajo concreto se colocó la pieza. Solo uno de los tres tiene
  // valor: saber la unidad no basta para rastrear una refacción, hay que
  // poder llegar al mantenimiento donde se usó. SetNull para que borrar la
  // bitácora no borre el rastro de la pieza en el inventario.
  usedOnMaintenanceLogId String?
  usedOnMaintenanceLog   MaintenanceLog? @relation(fields: [usedOnMaintenanceLogId], references: [id], onDelete: SetNull)

  usedOnValveChangeLogId String?
  usedOnValveChangeLog   ValveChangeLog? @relation(fields: [usedOnValveChangeLogId], references: [id], onDelete: SetNull)

  usedOnValveCorrectiveMaintenanceLogId String?
  usedOnValveCorrectiveMaintenanceLog   ValveCorrectiveMaintenanceLog? @relation(fields: [usedOnValveCorrectiveMaintenanceLogId], references: [id], onDelete: SetNull)

  fechaIngreso          DateTime  @default(now())
  fechaPorUtilizarDesde DateTime?
  fechaUtilizada        DateTime?

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inventory_items")
}

// PDFs adjuntos a un apartado, o a una unidad (VehicleRecord) específica dentro
// de un apartado de tipo "unidades" (vehicleRecordId presente). Solo un ADMIN
// puede subir/eliminar (validado en el server action); cualquier usuario con
// acceso a la ciudad puede descargarlos.
model Document {
  id String @id @default(cuid())

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  vehicleRecordId String?
  vehicleRecord   VehicleRecord? @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)

  maintenanceLogId String?
  maintenanceLog   MaintenanceLog? @relation(fields: [maintenanceLogId], references: [id], onDelete: Cascade)

  ultrasoundLogId String?
  ultrasoundLog   UltrasoundLog? @relation(fields: [ultrasoundLogId], references: [id], onDelete: Cascade)

  visualInspectionLogId String?
  visualInspectionLog   VisualInspectionLog? @relation(fields: [visualInspectionLogId], references: [id], onDelete: Cascade)

  tightnessTestLogId String?
  tightnessTestLog   TightnessTestLog? @relation(fields: [tightnessTestLogId], references: [id], onDelete: Cascade)

  internalVisualInspectionLogId String?
  internalVisualInspectionLog   InternalVisualInspectionLog? @relation(fields: [internalVisualInspectionLogId], references: [id], onDelete: Cascade)

  hydrostaticTestLogId String?
  hydrostaticTestLog   HydrostaticTestLog? @relation(fields: [hydrostaticTestLogId], references: [id], onDelete: Cascade)

  extinguisherChangeLogId String?
  extinguisherChangeLog   ExtinguisherChangeLog? @relation(fields: [extinguisherChangeLogId], references: [id], onDelete: Cascade)

  valveChangeLogId String?
  valveChangeLog   ValveChangeLog? @relation(fields: [valveChangeLogId], references: [id], onDelete: Cascade)

  valveCorrectiveMaintenanceLogId String?
  valveCorrectiveMaintenanceLog   ValveCorrectiveMaintenanceLog? @relation(fields: [valveCorrectiveMaintenanceLogId], references: [id], onDelete: Cascade)

  hoseChangeLogId String?
  hoseChangeLog   HoseChangeLog? @relation(fields: [hoseChangeLogId], references: [id], onDelete: Cascade)

  fileName   String
  storedName String
  mimeType   String
  size       Int

  // "ADJUNTO" (PDF genérico) | "ANTES" | "DESPUES" (fotos del mantenimiento).
  // Solo MaintenanceLog usa ANTES/DESPUES por ahora; el resto siempre queda
  // en el valor por defecto.
  kind String @default("ADJUNTO")

  uploadedById String?
  uploadedBy   User?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("documents")
}

model UserCityAccess {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, cityId])
  @@map("user_city_access")
}
