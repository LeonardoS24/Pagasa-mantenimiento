generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite no soporta enums nativos en Prisma; el rol se valida a nivel de
// aplicación con zod (ver lib/roles.ts) y se guarda como texto
// ("ADMIN" | "USUARIO" | "LECTOR"). ADMIN administra todo; USUARIO puede
// agregar/editar números económicos, fichas técnicas, bitácoras y archivos
// pero no crear/eliminar ciudades ni apartados, ni renombrar nada existente;
// LECTOR solo puede ver (equivalente al antiguo comportamiento de USUARIO).
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("USUARIO")
  // Puesto de la persona (ej. "Jefe de mantenimiento"), visible para
  // cualquiera en vez del rol técnico (ADMIN/USUARIO/LECTOR): ese rol solo
  // lo ve un ADMIN, en /admin/usuarios (ver components/layout/Header.tsx).
  puesto       String?
  // Aviso de 5 minutos al iniciar sesión cuando hay mantenimientos "En
  // proceso" en sus ciudades accesibles (ver actions/auth-actions.ts). Cada
  // usuario lo puede apagar para sí mismo.
  avisosMantenimientoActivos Boolean @default(true)
  // Acceso ampliado por horario (ver lib/elevated-access.ts): solo aplica a
  // rol USUARIO. Dentro de este horario puede editar/borrar registros y
  // ficha técnica como si fuera ADMIN; nunca alcanza para borrar
  // ciudades/apartados/usuarios ni cambiar roles — eso sigue exclusivo del
  // ADMIN real. accesoAmpliadoDias es JSON de un array de 0 (domingo) a 6
  // (sábado); las horas se guardan como "HH:MM" en hora local del servidor.
  accesoAmpliadoDias       String?
  accesoAmpliadoHoraInicio String?
  accesoAmpliadoHoraFin    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Todas estas relaciones usan onDelete: SetNull, nunca Cascade: eliminar a
  // un empleado no debe borrar el historial de mantenimiento de la flota. El
  // registro se conserva y solo pierde el nombre de quien lo capturó.
  cityAccess      UserCityAccess[]
  documents       Document[]
  maintenanceLogs               MaintenanceLog[]
  ultrasoundLogs                UltrasoundLog[]
  visualInspectionLogs          VisualInspectionLog[]
  tightnessTestLogs             TightnessTestLog[]
  internalVisualInspectionLogs  InternalVisualInspectionLog[]
  hydrostaticTestLogs           HydrostaticTestLog[]
  extinguisherChangeLogs        ExtinguisherChangeLog[]
  extinguisherQualityChangeLogs ExtinguisherQualityChangeLog[]
  valveChangeLogs               ValveChangeLog[]
  valveCorrectiveMaintenanceLogs ValveCorrectiveMaintenanceLog[]
  hoseChangeLogs                 HoseChangeLog[]
  pieceOrders                   PieceOrder[]
  inventoryItems                InventoryItem[]
  equipmentLogs                  EquipmentLog[]
  vehicleRecords                 VehicleRecord[]
  equipos                        Equipo[]
  activityLogs                   ActivityLog[]
  plantAreaMaintenanceLogs       PlantAreaMaintenanceLog[]

  @@map("users")
}

model City {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections   Section[]
  userAccess UserCityAccess[]

  @@map("cities")
}

model Section {
  id    String @id @default(cuid())
  name  String
  slug  String
  order Int    @default(0)

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Section?  @relation("SectionToSection", fields: [parentId], references: [id], onDelete: Cascade)
  children Section[] @relation("SectionToSection")

  vehicleRecords VehicleRecord[]
  documents      Document[]
  pieceOrders    PieceOrder[]
  inventoryItems InventoryItem[]
  equipos        Equipo[]
  plantAreaMaintenanceLogs PlantAreaMaintenanceLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cityId, parentId, slug])
  @@map("sections")
}

// Registros de unidades (autotanques, vehículos, etc.) que se muestran como
// tabla dentro de un apartado de "Unidad de distribución". El campo anterior
// guarda el número económico o la localidad anterior de la unidad, cuando aplica.
model VehicleRecord {
  id    String @id @default(cuid())
  order Int    @default(0)

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  // En "Estaciones de carburación" (dentro de Unidad de distribución, ver
  // scripts/add-estaciones-de-carburacion.mjs) numeroEconomico/sucursal se
  // reutilizan como "Nombre"/"Dirección" (ver components/admin/VehicleForm.tsx)
  // y anio/placas se dejan vacíos: no aplican a una estación fija. Para el
  // resto de las unidades, sucursal en realidad siempre guardó la marca del
  // vehículo (así lo usa el equipo desde antes de este sistema), por eso la
  // pantalla la llama "Marca" aunque la columna se siga llamando sucursal.
  numeroEconomico String
  sucursal        String
  anio            String?
  placas          String?
  // Texto libre (ver components/admin/VehicleForm.tsx): reemplazó a los
  // antiguos numeroAnterior/localidadAnterior, migrados aquí como texto.
  observaciones   String?

  // Solo para "Estaciones de carburación": datos generales del listado junto
  // con numeroEconomico ("Nombre") y sucursal ("Dirección"), editados juntos
  // en su propia ficha técnica de la estación (ver VehicleForm.tsx) — no se
  // separan de Dirección, a diferencia de la ficha técnica del tanque
  // (StationTankTechnicalSheetForm), que es un formulario distinto.
  permisionaria String?
  permiso       String?

  // Dar de baja no elimina la unidad: se conserva en el sistema (con toda su
  // ficha técnica, bitácora y documentos) marcada como inactiva. Solo un
  // ADMIN puede cambiar este estatus.
  activo    Boolean   @default(true)
  fechaBaja DateTime?
  // Motivo escrito al dar de baja (opcional, ver actions/vehicle-actions.ts:
  // setVehicleActive). Se borra al reactivar, igual que fechaBaja: no
  // conserva historial de bajas/reactivaciones pasadas, solo el motivo de la
  // baja actual si sigue inactiva.
  motivoBaja String?

  // Calidad general de la unidad (ver lib/vehicle-enums.ts:
  // calidadMantenimientoSchema): se recalcula sola con cada mantenimiento
  // registrado (el del registro con la fecha más cercana a hoy, ver
  // recalcularFichaTecnicaMantenimiento en actions/maintenance-actions.ts).
  // No se edita a mano, a diferencia de Equipo.criticidad.
  calidad String?

  // "OPERATIVA" | "EN_TALLER" | "FUERA_DE_SERVICIO" (ver lib/vehicle-enums.ts:
  // vehicleEstatusSchema). Se recalcula sola a EN_TALLER/OPERATIVA con cada
  // mantenimiento (mismo lugar que "calidad" arriba, según si queda algún
  // MaintenanceLog sin terminar) salvo que esté en FUERA_DE_SERVICIO, que es
  // manual y no se pisa solo. También se puede cambiar a mano desde el botón
  // rápido del listado (ver setVehicleEstatus en actions/vehicle-actions.ts);
  // marcarla OPERATIVA a mano cierra ahí mismo los mantenimientos abiertos.
  estatus String @default("OPERATIVA")

  documents                    Document[]
  // Valores de los recuadros extra que se hayan agregado a su ficha técnica
  // desde el panel (ver CustomField).
  customFieldValues            CustomFieldValue[]
  technicalSheet               VehicleTechnicalSheet?
  // Solo para "Estaciones de carburación" (ver StationTankTechnicalSheet más
  // abajo): reemplaza la sección "Tanque" de VehicleTechnicalSheet con campos
  // propios de recipiente a presión. Las fechas de vencimiento de las 5
  // inspecciones periódicas siguen viviendo en VehicleTechnicalSheet (mismo
  // sistema de alertas que cualquier otro tanque) — son de la estación, no
  // de un tanque en particular.
  //
  // Normalmente es una sola (etiqueta "Tanque 1"), pero algunas estaciones
  // tienen dos tanques físicos (dos números de serie, dos ultrasonidos):
  // para esas, un segundo registro con etiqueta "Tanque 2" — cada uno con
  // sus propios datos de recipiente y su propio juego de válvulas (ver
  // lib/station-valves.ts), que es lo que de verdad cambia entre un tanque y
  // otro dentro de la misma estación.
  stationTankTechnicalSheets   StationTankTechnicalSheet[]
  // Solo para "Estaciones de carburación": equipos propios de esa estación
  // (ver Equipo.vehicleRecordId), aparte de los "Equipos de planta" a nivel
  // ciudad.
  equipos                      Equipo[]
  maintenanceLogs              MaintenanceLog[]
  ultrasoundLogs               UltrasoundLog[]
  visualInspectionLogs         VisualInspectionLog[]
  tightnessTestLogs            TightnessTestLog[]
  internalVisualInspectionLogs InternalVisualInspectionLog[]
  hydrostaticTestLogs          HydrostaticTestLog[]
  extinguisherChangeLogs       ExtinguisherChangeLog[]
  extinguisherQualityChangeLogs ExtinguisherQualityChangeLog[]
  valveChangeLogs              ValveChangeLog[]
  valveCorrectiveMaintenanceLogs ValveCorrectiveMaintenanceLog[]
  hoseChangeLogs                HoseChangeLog[]
  // Piezas de inventario (de cualquier ciudad) que se marcaron "Utilizada" en
  // esta unidad (ver actions/inventory-actions.ts). No es lo mismo que
  // "documents"/"maintenanceLogs": es solo trazabilidad de dónde se colocó
  // cada pieza.
  inventoryItemsColocados       InventoryItem[]
  // Órdenes de pieza que ya se levantaron sabiendo que eran para esta unidad
  // (ver PieceOrder.vehicleRecordId).
  pieceOrders                   PieceOrder[]

  // Quién dio de alta la unidad, para la bitácora de actividad del sistema
  // (ver app/(protected)/admin/actividad).
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicle_records")
}

// Ficha técnica vehicular: datos del automóvil y, si aplica, del tanque de
// gas LP que transporta. Relación 1:1 opcional con VehicleRecord (no todos
// los vehículos la tienen llenada de inmediato).
model VehicleTechnicalSheet {
  id String @id @default(cuid())

  vehicleRecordId String        @unique
  vehicleRecord   VehicleRecord @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)

  // Automóvil
  // "Marca" se eligió de un catálogo (ver lib/vehicle-brand-catalog.ts) que
  // también sugiere Línea/Modelo — a diferencia de VehicleRecord.sucursal
  // (que la pantalla llama "Marca" en datos generales), este es un dato más
  // detallado con clasificación completa, no un duplicado.
  marca             String?
  linea             String?
  modelo            String?
  peso              String?
  // Solo para Vehículo de reparto y Vehículo con tanque de carburación:
  // reemplazan a "peso" en el formulario (ver useDeliveryFormat).
  pesoBrutoVacio    String?
  pesoBrutoMaximo   String?
  serie             String?
  combustible       String? // "GAS_LP" | "GASOLINA" | "DIESEL" | "ELECTRICA"
  caracteristicas   String?
  ubicacion         String?
  potencia          String?
  horasUsoDiario    String?
  fechaAdquisicion  DateTime?
  // Chofer asignado y datos del seguro de la unidad. Igual que el resto de
  // "Automóvil": mismo vehículo físico en el par Auto-Tanques/Vehículo con
  // tanque de carburación, así que solo se captura y se imprime una vez (ver
  // showAutomovilSection en TechnicalSheetView.tsx e imprimir/page.tsx).
  chofer         String?
  numeroPoliza   String?
  inciso         String?

  // Tanque
  capacidadTanque       String?
  marcaTanque           String?
  anioFabricacionTanque String?
  // Fecha de fabricación real (a diferencia de anioFabricacionTanque, texto
  // libre): ancla el cálculo automático de la inspección visual interna y la
  // prueba hidrostática, que vencen cada 10 años a partir de esta fecha.
  fechaFabricacionTanque DateTime?
  numeroSerieTanque     String?
  numeroUltimoUltrasonido String?
  ultimoUltrasonido     DateTime?
  fechaProximoUltrasonido DateTime?

  // Inspección visual EXTERNA (mismo mecanismo que el ultrasonido, ver VisualInspectionLog)
  numeroUltimaInspeccionVisual String?
  ultimaInspeccionVisual       DateTime?
  fechaProximaInspeccionVisual DateTime?

  // Prueba de hermeticidad (mismo mecanismo, fecha próxima manual, ver TightnessTestLog)
  numeroUltimaPruebaHermeticidad String?
  ultimaPruebaHermeticidad       DateTime?
  fechaProximaPruebaHermeticidad DateTime?

  // Inspección visual INTERNA: vence cada 10 años a partir de
  // fechaFabricacionTanque; fechaProxima se calcula sola si se deja vacía
  // (ver actions/vehicle-actions.ts e internal-visual-inspection-actions.ts).
  numeroUltimaInspeccionVisualInterna String?
  ultimaInspeccionVisualInterna       DateTime?
  fechaProximaInspeccionVisualInterna DateTime?

  // Prueba hidrostática: mismo esquema de 10 años que la inspección visual interna.
  numeroUltimaPruebaHidrostatica String?
  ultimaPruebaHidrostatica       DateTime?
  fechaProximaPruebaHidrostatica DateTime?

  // Extintor: aplica a TODOS los tipos de unidad (no solo Auto-Tanques). La
  // alerta no se basa en fecha próxima sino en la calidad: cuando pasa a
  // "MALA" se guarda fechaCalidadMalaExtintor (primera vez que se detectó);
  // amarilla los primeros 2 días desde esa fecha, roja después. Se limpia si
  // la calidad vuelve a Excelente/Buena (ver actions/vehicle-actions.ts y
  // actions/extinguisher-actions.ts).
  fechaInstalacionExtintor DateTime?
  fechaVencimientoExtintor DateTime?
  calidadExtintor          String? // "EXCELENTE" | "BUENA" | "MALA"
  fechaCalidadMalaExtintor DateTime?

  // Mantenimiento preventivo: se actualiza automáticamente con cada
  // mantenimiento que incluya kilometraje (ver actions/maintenance-actions.ts).
  // El siguiente preventivo se calcula en ese momento como
  // kilometrajeUltimoMantenimiento + 10,000 km y fechaUltimoMantenimiento + 6
  // meses; el aviso (como el de ultrasonido) se evalúa por fecha, que es lo
  // único que se puede verificar sin un kilometraje en vivo — el kilometraje
  // objetivo se muestra como referencia para que el personal lo confirme
  // contra el odómetro real.
  kilometrajeUltimoMantenimiento   Int?
  fechaUltimoMantenimiento         DateTime?
  kilometrajeProximoMantenimiento  Int?
  fechaProximoMantenimiento        DateTime?

  // Cambio de válvulas: Auto-Tanques y Vehículo con tanque de carburación
  // (ver showValveSection en la página de detalle de vehículo). Cada válvula
  // guarda su propia fecha de fabricación; la alerta (igual que la de
  // ultrasonido) se calcula sobre la más antigua de todas, venciendo a los 5
  // años (ver lib/valve-alerts.ts). fechaInstalacionValvulas es la fecha
  // general en que se instaló el juego de válvulas. tieneValvulaMaximoLlenado85
  // marca si la unidad tiene esa válvula (no todas la tienen); solo si es
  // true participa fechaFabricacionValvulaMaximoLlenado85 en el cálculo.
  fechaInstalacionValvulas                    DateTime?
  fechaFabricacionValvulaLlenado              DateTime?
  fechaFabricacionValvulaNoRetroceso          DateTime?
  fechaFabricacionValvulaBypass               DateTime?
  fechaFabricacionValvulaRetornoVapores       DateTime?
  fechaFabricacionValvulaServicio             DateTime?
  fechaFabricacionValvulaMaximoLlenado        DateTime?
  tieneValvulaMaximoLlenado85                 Boolean   @default(false)
  fechaFabricacionValvulaMaximoLlenado85      DateTime?
  fechaFabricacionValvulaAlivio               DateTime?
  fechaFabricacionValvulaDescargaEmergencia   DateTime?

  // Cambio de mangueras: solo para Vehículo con tanque de carburación. La
  // alerta vence a los 2 años (mismo esquema que las válvulas, pero con
  // ciclo más corto) y se calcula sobre fechaFabricacionManguera;
  // fechaInstalacionMangueras es la fecha general en que se instaló la
  // manguera (ver lib/hose-alerts.ts).
  fechaInstalacionMangueras DateTime?
  fechaFabricacionManguera  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicle_technical_sheets")
}

// Ficha técnica del tanque de una Estación de carburación: a diferencia de
// VehicleTechnicalSheet (pensada para el tanque de carga de un Auto-Tanque),
// esta usa el vocabulario propio de un recipiente a presión fijo. Las fechas
// de vencimiento de las 5 inspecciones periódicas (ultrasonido, visual
// externa/interna, hermeticidad, hidrostática) NO están aquí — siguen
// viviendo en VehicleTechnicalSheet, que toda unidad (incluidas las
// estaciones) sigue teniendo, para reutilizar el mismo sistema de alertas.
model StationTankTechnicalSheet {
  id String @id @default(cuid())

  vehicleRecordId String
  vehicleRecord   VehicleRecord @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)
  // "Tanque 1" (la inmensa mayoría de estaciones) o "Tanque 2", cuando la
  // estación tiene un segundo tanque físico (ver comentario en
  // VehicleRecord.stationTankTechnicalSheets).
  etiqueta        String @default("Tanque 1")

  numeroSerie          String?
  marca                String?
  modelo               String?
  tipo                 String?
  anioFabricacion      String?
  fechaFabricacion     DateTime?
  capacidad            String?
  presionDiseno        String?
  longitudTotal        String?
  formaCabeza          String?
  espesorNominalCuerpo String?
  espesorNominalCabeza String?
  materialCuerpo       String?
  materialCabeza       String?
  diametroInterior     String?
  tara                 String?

  // Válvulas del tanque fijo. Son otro juego que el de un Auto-Tanque (ver
  // lib/station-valves.ts y VehicleTechnicalSheet): aquí hay exceso de flujo
  // y check lock, y no hay bypass, retorno de vapores, máximo llenado ni
  // descarga de emergencia. La de relevo hidrostático va en la tubería, no
  // en el tanque, así que no forma parte de este juego.
  //
  // Como en las unidades, se guarda la fecha de fabricación grabada en cada
  // válvula más la fecha en que se instaló el juego completo.
  fechaInstalacionValvulas                  DateTime?
  fechaFabricacionValvulaExcesoFlujo        DateTime?
  fechaFabricacionValvulaNoRetroceso        DateTime?
  fechaFabricacionValvulaSeguridad          DateTime?
  fechaFabricacionValvulaLlenado            DateTime?
  fechaFabricacionValvulaServicio           DateTime?
  fechaFabricacionValvulaCheckLock          DateTime?
  fechaFabricacionValvulaVapor              DateTime?

  // Válvulas e instrumentos de un tanque de Planta (ver
  // lib/planta-tank-instruments.ts): solo se usan cuando este registro es de
  // Planta, no de una Estación de carburación (que sigue usando el juego de
  // arriba, un solo vencimiento combinado). A diferencia de las válvulas de
  // estación, cada instrumento aquí lleva sus 3 fechas propias
  // (fabricación/cambio/instalación) y su propia alerta por separado.
  maximoLlenadoFechaFabricacion              DateTime?
  maximoLlenadoFechaCambio                   DateTime?
  maximoLlenadoFechaInstalacion              DateTime?
  manometroFechaFabricacion                  DateTime?
  manometroFechaCambio                       DateTime?
  manometroFechaInstalacion                  DateTime?
  termometroFechaFabricacion                 DateTime?
  termometroFechaCambio                      DateTime?
  termometroFechaInstalacion                 DateTime?
  excesoFlujoNoRetrocesoFechaFabricacion     DateTime?
  excesoFlujoNoRetrocesoFechaCambio          DateTime?
  excesoFlujoNoRetrocesoFechaInstalacion     DateTime?
  relevoPresionFechaFabricacion              DateTime?
  relevoPresionFechaCambio                   DateTime?
  relevoPresionFechaInstalacion              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vehicleRecordId, etiqueta])
  @@map("station_tank_technical_sheets")
}

// Entrada de bitácora de mantenimiento de una unidad. El estatus se muestra
// como resumen bajo la ficha técnica del vehículo y también alimenta el feed
// de "Bitácoras de unidades" a nivel ciudad (ordenado por fecha).
model MaintenanceLog {
  id String @id @default(cuid())

  vehicleRecordId String
  vehicleRecord   VehicleRecord @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)

  tipoMantenimiento String
  tipoServicio      String
  // Calidad general de la unidad reportada en este mantenimiento (ver
  // lib/vehicle-enums.ts: calidadMantenimientoSchema). Obligatoria desde que
  // se agregó (ver actions/maintenance-actions.ts); nula en registros
  // capturados antes. Cada vez que se crea/edita/borra un mantenimiento se
  // recalcula VehicleRecord.calidad a partir del más cercano a hoy.
  calidad           String?
  // Categoría y pieza vienen del catálogo fijo en lib/piece-catalog.ts
  // (categoría "Otro" = pieza escrita a mano en el mismo campo "pieza").
  // accionPieza alimenta el gráfico de piezas con más mantenimiento por
  // tipo de acción (ver components/city/PieceMaintenanceChart.tsx).
  categoriaPieza    String?
  pieza             String?
  accionPieza       String?
  // Checklist completo de mantenimiento preventivo (JSON: [{item, estado}],
  // ver lib/preventive-checklist.ts). Solo se llena cuando tipoMantenimiento
  // es "Preventivo"; se guarda completo para auditoría, aunque solo los
  // ítems marcados "Cambio" generan su propio registro de pieza (ver
  // actions/maintenance-actions.ts).
  checklistPreventivo String?
  cantidad          String?
  unidad            String?
  descripcion       String?
  observacion       String?
  fecha             DateTime
  // Kilometraje del odómetro al momento de este mantenimiento. Si viene, se
  // usa para actualizar la ficha técnica y calcular el próximo mantenimiento
  // preventivo (ver actions/maintenance-actions.ts).
  kilometraje       Int?

  nombreOperador             String?
  auxiliarTecnico            String?
  responsableTrabajoMecanico String?

  // "SIN_ATENCION" | "EN_PROCESO" | "TERMINADO" | "CANCELADO"
  estatus String @default("SIN_ATENCION")

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  documents Document[]

  // Piezas de inventario que se colocaron en este mantenimiento.
  piezasUtilizadas InventoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("maintenance_logs")
}

// Piezas "aprendidas" de tanto escribirse a mano en el campo libre de
// MaintenanceLog.pieza (categoría "Otro"/sin categoría): cuando el mismo
// nombre (sin importar mayúsculas/minúsculas ni acentos, comparación hecha
// en JS porque SQLite no soporta bien mayúsculas/minúsculas con acentos) se
// escribe 3 veces o más, se agrega aquí para que a partir de entonces
// aparezca como opción seleccionable en vez de tener que volver a escribirla
// (ver lib/learned-pieces.ts).
// Piezas del catálogo que no vienen en la lista fija de lib/piece-catalog.ts:
// las que el sistema aprende solo de tanto escribirlas a mano (categoría
// "Otro", ver lib/learned-pieces.ts) y las que un ADMIN agrega desde el panel
// (ver /admin/piezas y actions/piece-catalog-actions.ts). Son lo mismo desde
// el punto de vista del catálogo, por eso comparten tabla.
// Recuadros extra que un ADMIN agrega a las fichas técnicas desde el panel
// (ver /admin/campos y lib/custom-fields.ts). No tocan las columnas fijas de
// VehicleTechnicalSheet ni StationTankTechnicalSheet: sus valores viven en
// CustomFieldValue. Así las alertas, el semáforo y los vencimientos, que
// dependen de esas columnas, siguen funcionando igual.
model CustomField {
  id String @id @default(cuid())
  // "VEHICULO" | "ESTACION" (ver CAMPO_AMBITOS en lib/custom-fields.ts)
  ambito String
  // Recuadro donde aparece ("automovil", "tanque", ...): coincide con las
  // claves de SECTION_STYLES para heredar el color de esa sección.
  seccion  String
  etiqueta String
  // "TEXTO" | "TEXTO_LARGO" | "NUMERO" | "FECHA"
  tipo  String @default("TEXTO")
  orden Int    @default(0)

  valores CustomFieldValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("custom_fields")
}

// El valor capturado de un campo extra para una unidad concreta. Se guarda
// siempre como texto: el tipo solo decide qué control se muestra y cómo se
// valida al capturar, no cómo se almacena.
model CustomFieldValue {
  id String @id @default(cuid())

  fieldId String
  field   CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  vehicleRecordId String
  vehicleRecord   VehicleRecord @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)

  valor String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fieldId, vehicleRecordId])
  @@map("custom_field_values")
}

// Ítems que un ADMIN agrega al checklist de mantenimiento preventivo desde
// el panel (ver /admin/piezas y actions/checklist-actions.ts). La lista base
// vive en el código (lib/preventive-checklist.ts); estos se suman a ella.
model ChecklistItemExtra {
  id String @id @default(cuid())
  // "GENERAL" (cualquier unidad) | "CARBURACION" (Vehículo con tanque de
  // carburación, que tiene su propio checklist).
  lista  String
  nombre String
  // Para "CARBURACION": si el ítem solo se revisa por fugas o admite
  // reparación/sustitución (ver checklistEstadoOptionsFor). Ignorado en
  // "GENERAL", donde todos los ítems usan el mismo juego de estados.
  soloFugas Boolean  @default(false)
  orden     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([lista, nombre])
  @@map("checklist_items_extra")
}

// Registro de mantenimiento de una de las 15 áreas operativas fijas de Planta
// (ver lib/plant-areas.ts: A–O, texto exacto del reglamento). Las áreas no
// son filas de una tabla propia, solo una lista fija del código — aquí solo
// se guarda la clave (A–O) de cuál fue.
model PlantAreaMaintenanceLog {
  id String @id @default(cuid())

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  area String

  fecha DateTime
  // [{item, hecho, observacion}], ver lib/plant-area-checklist-runtime.ts:
  // lista base del código ("Limpieza", "Inspección de equipos") más los
  // ítems que un ADMIN agregue por área desde el panel (PlantAreaChecklistItem).
  checklist String

  responsable   String?
  observaciones String?

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("plant_area_maintenance_logs")
}

// Ítems que un ADMIN agrega al checklist de mantenimiento de un área de
// Planta en particular (ver PlantAreaMaintenanceLog arriba), sumándose a la
// lista base fija del código ("Limpieza", "Inspección de equipos"). Mismo
// patrón que ChecklistItemExtra, pero por área en vez de por lista.
model PlantAreaChecklistItem {
  id    String @id @default(cuid())
  area  String
  nombre String
  orden Int    @default(0)

  createdAt DateTime @default(now())

  @@unique([area, nombre])
  @@map("plant_area_checklist_items")
}

model LearnedPiece {
  id        String   @id @default(cuid())
  categoria String
  nombre    String
  // "UNIDADES" | "ESTACIONES" (ver lib/piece-catalog.ts: PIECE_GROUPS). Solo
  // hace falta para saber a qué grupo pertenece una CATEGORÍA nueva creada
  // desde el panel; las categorías de la lista fija ya se sabe cuáles son.
  // null en las aprendidas solas (categoría "Otro", que no es de un grupo).
  grupo     String?
  createdAt DateTime @default(now())

  @@unique([categoria, nombre])
  @@map("learned_pieces")
}

// Registro de cada realización de ultrasonido de tanque (Auto-Tanques). Al
// crearse, actualiza automáticamente ultimoUltrasonido/numeroUltimoUltrasonido
// en la ficha técnica del vehículo (ver actions/ultrasound-actions.ts), de
// modo que la ficha técnica siempre refleje el ultrasonido más reciente
// mientras este registro conserva el historial completo (compañía,
// responsable, documentos) de cada evento.
model UltrasoundLog {
  id String @id @default(cuid())

  vehicleRecordId String
  vehicleRecord   VehicleRecord @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)

  compania          String?
  numeroUltrasonido String?
  responsable       String?

  // Fecha del ultrasonido anterior, capturada como referencia al momento de
  // registrar este nuevo evento.
  fechaUltimoUltrasonido DateTime?
  // Fecha en que se realizó este nuevo ultrasonido (pasa a ser el
  // "ultimoUltrasonido" de la ficha técnica al aceptar el registro).
  fechaRealizacion DateTime
  // Fecha del próximo ultrasonido (pasa a ser "fechaProximoUltrasonido" de la
  // ficha técnica al aceptar el registro, que es lo que dispara la alerta
  // amarilla/roja en VehicleTable y el panel del dashboard).
  fechaProximoUltrasonido DateTime

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ultrasound_logs")
}

// Registro de cada realización de inspección visual de tanque (Auto-Tanques).
// Funciona igual que UltrasoundLog: al crearse, actualiza automáticamente
// ultimaInspeccionVisual/numeroUltimaInspeccionVisual en la ficha técnica del
// vehículo (ver actions/visual-inspection-actions.ts).
model VisualInspectionLog {
  id String @id @default(cuid())

  vehicleRecordId String
  vehicleRecord   VehicleRecord @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)

  compania        String?
  numeroInspeccion String?
  responsable     String?

  // Fecha de la inspección visual anterior, capturada como referencia al
  // momento de registrar este nuevo evento.
  fechaUltimaInspeccion DateTime?
  // Fecha en que se realizó esta nueva inspección visual (pasa a ser la
  // "ultimaInspeccionVisual" de la ficha técnica al aceptar el registro).
  fechaRealizacion DateTime
  // Fecha de la próxima inspección visual externa (pasa a ser
  // "fechaProximaInspeccionVisual" de la ficha técnica al aceptar el
  // registro, que es lo que dispara la alerta).
  fechaProximaInspeccion DateTime

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("visual_inspection_logs")
}

// Registro de cada realización de prueba de hermeticidad de tanque
// (Auto-Tanques). Funciona igual que VisualInspectionLog: fecha próxima
// manual en la ficha técnica, se revisa típicamente cada año.
model TightnessTestLog {
  id String @id @default(cuid())

  vehicleRecordId String
  vehicleRecord   VehicleRecord @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)

  compania    String?
  numeroPrueba String?
  responsable String?

  fechaUltimaPrueba DateTime?
  fechaRealizacion  DateTime
  // Fecha de la próxima prueba de hermeticidad (pasa a ser
  // "fechaProximaPruebaHermeticidad" de la ficha técnica al aceptar el
  // registro, que es lo que dispara la alerta).
  fechaProximaPrueba DateTime

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tightness_test_logs")
}

// Registro de cada realización de inspección visual INTERNA de tanque
// (Auto-Tanques). A diferencia de UltrasoundLog/VisualInspectionLog, al
// aceptarse recalcula fechaProximaInspeccionVisualInterna automáticamente
// como fechaRealizacion + 10 años (ver actions/internal-visual-inspection-actions.ts).
model InternalVisualInspectionLog {
  id String @id @default(cuid())

  vehicleRecordId String
  vehicleRecord   VehicleRecord @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)

  compania         String?
  numeroInspeccion String?
  responsable      String?

  fechaUltimaInspeccion DateTime?
  fechaRealizacion      DateTime

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("internal_visual_inspection_logs")
}

// Registro de cada realización de prueba hidrostática de tanque
// (Auto-Tanques). Mismo esquema de recalculo automático a 10 años que
// InternalVisualInspectionLog.
model HydrostaticTestLog {
  id String @id @default(cuid())

  vehicleRecordId String
  vehicleRecord   VehicleRecord @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)

  compania     String?
  numeroPrueba String?
  responsable  String?

  fechaUltimaPrueba DateTime?
  fechaRealizacion  DateTime

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hydrostatic_test_logs")
}

// Registro de cada cambio/inspección de extintor. Aplica a TODOS los tipos
// de unidad. Al aceptarse actualiza automáticamente fechaInstalacionExtintor,
// fechaVencimientoExtintor y calidadExtintor en la ficha técnica (ver
// actions/extinguisher-actions.ts).
model ExtinguisherChangeLog {
  id String @id @default(cuid())

  vehicleRecordId String
  vehicleRecord   VehicleRecord @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)

  responsable String?

  fechaInstalacion DateTime
  fechaVencimiento DateTime
  calidad          String // "EXCELENTE" | "BUENA" | "MALA"
  fechaRealizacion DateTime

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("extinguisher_change_logs")
}

// Historial de cambios de estado del extintor (a diferencia de
// ExtinguisherChangeLog, que registra cuándo se instaló físicamente un
// extintor nuevo): cada vez que la calidad reportada cambia — por el cambio
// rápido en la ficha técnica (ver actions/vehicle-actions.ts:
// updateCalidadExtintor) o al editar la ficha técnica completa — queda un
// renglón aquí con el antes/después. Cuando la calidad nueva es "MALA" se
// exige una observación explicando por qué (aplica a todas las unidades, no
// solo a Estaciones de carburación).
model ExtinguisherQualityChangeLog {
  id String @id @default(cuid())

  vehicleRecordId String
  vehicleRecord   VehicleRecord @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)

  calidadAnterior String?
  calidadNueva    String
  observacion     String?

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("extinguisher_quality_change_logs")
}

// Registro de cada cambio de válvulas de tanque. Solo aplica a Vehículo con
// tanque de carburación. Cada una de las 4 válvulas guarda su propia fecha
// de fabricación (usadas para la alerta de 5 años); fechaInstalacion es la
// fecha general en que se instaló el juego completo. Al aceptarse, actualiza
// automáticamente los 5 campos correspondientes en la ficha técnica (ver
// actions/valve-actions.ts).
model ValveChangeLog {
  id String @id @default(cuid())

  vehicleRecordId String
  vehicleRecord   VehicleRecord @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)

  // Antes era un solo "responsable": ahora se distingue quién hizo el cambio
  // físico de quién lo supervisó/validó, porque no siempre son la misma
  // persona y en la bitácora en papel se firman por separado.
  responsableCambio      String?
  responsableSupervision String?

  fechaInstalacion DateTime

  fechaFabricacionValvulaLlenado       DateTime
  fechaFabricacionValvulaServicio      DateTime
  fechaFabricacionValvulaMaximoLlenado DateTime
  fechaFabricacionValvulaAlivio        DateTime
  // Las 4 de arriba aplican a Auto-Tanques y a Vehículo con tanque de
  // carburación (con otros nombres ahí: Doble check/purgador/reguladora/
  // seguridad, ver TechnicalSheetForm). Las 4 de abajo (más la opcional del
  // 85%) son propias del tanque de carga y solo aplican a Auto-Tanques —
  // nulas en Vehículo con tanque de carburación (ver actions/valve-actions.ts).
  fechaFabricacionValvulaNoRetroceso        DateTime?
  fechaFabricacionValvulaBypass             DateTime?
  fechaFabricacionValvulaRetornoVapores     DateTime?
  fechaFabricacionValvulaDescargaEmergencia DateTime?
  // Única opcional del juego para Auto-Tanques: no todos los tanques de
  // carga la tienen.
  tieneValvulaMaximoLlenado85            Boolean   @default(false)
  fechaFabricacionValvulaMaximoLlenado85 DateTime?

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  documents Document[]

  // Piezas de inventario que se colocaron en este cambio de válvulas.
  piezasUtilizadas InventoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("valve_change_logs")
}

// Registro de mantenimiento CORRECTIVO de válvulas (reparación puntual fuera
// del ciclo preventivo de 5 años de ValveChangeLog). Solo aplica a Vehículo
// con tanque de carburación. No sincroniza nada en la ficha técnica: es solo
// historial de qué se reparó, cuándo y en qué válvula.
model ValveCorrectiveMaintenanceLog {
  id String @id @default(cuid())

  vehicleRecordId String
  vehicleRecord   VehicleRecord @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)

  // "LLENADO" | "SERVICIO" | "MAXIMO_LLENADO" | "ALIVIO" | "GENERAL" (ver lib/valve-alerts.ts)
  valvula     String
  descripcion String
  responsable String?
  fecha       DateTime

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  documents Document[]

  // Piezas de inventario que se colocaron en este mantenimiento correctivo.
  piezasUtilizadas InventoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("valve_corrective_maintenance_logs")
}

// Registro de cada cambio de manguera de tanque de carburación. Solo aplica
// a Vehículo con tanque de carburación. fechaFabricacionManguera ancla la
// alerta de 2 años (mismo esquema que ValveChangeLog pero con ciclo más
// corto y una sola fecha); fechaInstalacion es la fecha general en que se
// instaló. Al
// aceptarse, actualiza automáticamente los 2 campos correspondientes en la
// ficha técnica (ver actions/hose-actions.ts).
model HoseChangeLog {
  id String @id @default(cuid())

  vehicleRecordId String
  vehicleRecord   VehicleRecord @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)

  responsable String?

  fechaInstalacion         DateTime
  fechaFabricacionManguera DateTime

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hose_change_logs")
}

// Orden de una pieza común solicitada para una ciudad, en el apartado "Orden
// de Pieza". Al marcarse como ACEPTADA se crea automáticamente un
// InventoryItem correspondiente en el apartado de Inventarios de la misma
// ciudad (ver actions/piece-order-actions.ts). El registro de la orden
// permanece aquí sin importar su estatus final.
model PieceOrder {
  id String @id @default(cuid())

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  // "REFACCION" | "PIEZA" | "HERRAMIENTA" | "CONSUMIBLE" (ver lib/inventory-enums.ts)
  tipo String
  // Qué se pide en concreto ("Balata delantera", "Aceite 15W40"). Por ahora
  // es texto libre; más adelante puede volverse un catálogo seleccionable.
  nombre String
  // Unidad ya resuelta: "PZA" para los contables, "LTS"/"KG" para consumibles.
  unidad     String
  cantidad   Int
  fechaOrden DateTime

  // "PENDIENTE" | "ACEPTADA" | "RECHAZADA" | "EN_INVENTARIO"
  estado String @default("PENDIENTE")

  // "ALTA" | "NORMAL". Se fija sola al crear la orden: ALTA cuando
  // vehicleRecordId apunta a una unidad cuya calidad (VehicleRecord.calidad)
  // es "MALA" (ver createPieceOrder en actions/piece-order-actions.ts). No se
  // vuelve a recalcular si la calidad de la unidad cambia después. Dispara el
  // aviso de inicio de sesión (ver consumePendingHighPriorityOrderAlert en
  // actions/user-actions.ts).
  prioridad String @default("NORMAL")

  // Momento en que la orden pasó a ACEPTADA (se vuelve a fijar cada vez que
  // pasa a ese estado). Ancla el plazo de 2 semanas tras el cual, si nadie la
  // pasó a EN_INVENTARIO a mano, se hace sola (ver
  // sweepExpiredAcceptedOrders en actions/piece-order-actions.ts).
  fechaAceptada DateTime?

  // Unidad destino, cuando ya se sabe desde que se levanta la orden (no
  // siempre se sabe). Al aceptarse la orden, el/los renglón(es) de inventario
  // que genera nacen ya amarrados a esta unidad (ver
  // createInventoryItemsForAcceptedOrder en actions/piece-order-actions.ts),
  // así que marcarlos "Utilizada" después ya no pide elegir la unidad de
  // nuevo. SetNull para no perder la orden si la unidad se elimina.
  vehicleRecordId String?
  vehicleRecord   VehicleRecord? @relation(fields: [vehicleRecordId], references: [id], onDelete: SetNull)

  // Checklist al levantar una orden tipo "EQUIPO" (ver
  // components/admin/CreatePieceOrderForm.tsx): si ya se sabe que sustituye
  // a un equipo existente, queda ligado aquí a modo de referencia — no lo da
  // de baja solo; eso lo sigue haciendo su propia bitácora ("Cambio", ver
  // Equipo.activo). SetNull para no perder la orden si el equipo se elimina.
  sustituyeEquipoId String?
  sustituyeEquipo   Equipo? @relation(fields: [sustituyeEquipoId], references: [id], onDelete: SetNull)

  // Una orden aceptada genera VARIOS renglones de inventario cuando el tipo
  // es contable (5 refacciones -> 5 renglones independientes); el consumible
  // genera uno solo con el total.
  inventoryItems InventoryItem[]

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("piece_orders")
}

// Pieza en inventario, generada automáticamente al aceptar una PieceOrder.
// "POR_UTILIZAR" pasa a "UTILIZADA" automáticamente 5 días después de
// marcarse (barrido en actions/inventory-actions.ts que corre cada vez que
// se visita el apartado de Inventarios de esa ciudad). Una vez "UTILIZADA"
// el registro se conserva pero se muestra al final de la lista, igual que
// al dar de baja una unidad.
model InventoryItem {
  id String @id @default(cuid())

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  pieceOrderId String?
  pieceOrder   PieceOrder? @relation(fields: [pieceOrderId], references: [id], onDelete: SetNull)

  // Mismos campos que la orden que lo generó (ver lib/inventory-enums.ts).
  tipo     String
  nombre   String
  unidad   String
  cantidad Int

  // "EN_INVENTARIO" | "POR_UTILIZAR" | "UTILIZADA"
  estado String @default("EN_INVENTARIO")

  // Unidad en la que se colocó la pieza. Se pide obligatoriamente al marcar
  // "Utilizada" (ver actions/inventory-actions.ts); onDelete SetNull para no
  // perder el historial del inventario si la unidad se elimina después.
  usedOnVehicleId String?
  usedOnVehicle   VehicleRecord? @relation(fields: [usedOnVehicleId], references: [id], onDelete: SetNull)

  // En qué trabajo concreto se colocó la pieza. Solo uno de los tres tiene
  // valor: saber la unidad no basta para rastrear una refacción, hay que
  // poder llegar al mantenimiento donde se usó. SetNull para que borrar la
  // bitácora no borre el rastro de la pieza en el inventario.
  usedOnMaintenanceLogId String?
  usedOnMaintenanceLog   MaintenanceLog? @relation(fields: [usedOnMaintenanceLogId], references: [id], onDelete: SetNull)

  usedOnValveChangeLogId String?
  usedOnValveChangeLog   ValveChangeLog? @relation(fields: [usedOnValveChangeLogId], references: [id], onDelete: SetNull)

  usedOnValveCorrectiveMaintenanceLogId String?
  usedOnValveCorrectiveMaintenanceLog   ValveCorrectiveMaintenanceLog? @relation(fields: [usedOnValveCorrectiveMaintenanceLogId], references: [id], onDelete: SetNull)

  fechaIngreso          DateTime  @default(now())
  fechaPorUtilizarDesde DateTime?
  fechaUtilizada        DateTime?

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inventory_items")
}

// Equipo del apartado único "Equipos" (fusiona lo que antes eran Equipos
// Mecánicos y Equipos electrónicos). tipoEquipo decide qué subconjunto de
// campos aplica y de qué color se pinta en la lista y en la bitácora (ver
// lib/equipo-enums.ts): MECANICO, ELECTRICO (cubre eléctrico y electrónico,
// el usuario pidió un solo tipo para ambos) y AUXILIAR. La mayoría de los
// campos son opcionales porque cada tipo solo llena su propio subconjunto.
model Equipo {
  id    String @id @default(cuid())
  order Int    @default(0)

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  // Solo cuando este equipo pertenece a una Estación de carburación en
  // particular (no a los "Equipos de planta" a nivel ciudad): sectionId
  // sigue apuntando al apartado "Estaciones de carburación" (para que el
  // borrado en cascada de la ciudad/apartado lo siga alcanzando), pero el
  // listado de la estación filtra por este campo y el listado de "Equipos de
  // planta" excluye los que sí lo tienen.
  vehicleRecordId String?
  vehicleRecord   VehicleRecord? @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)

  tipoEquipo String // "MECANICO" | "ELECTRICO" | "AUXILIAR"

  // Se da de baja automáticamente cuando se registra un mantenimiento tipo
  // "Cambio" en su bitácora (ver actions/equipment-log-actions.ts): el
  // equipo se reemplaza por uno nuevo, y este se conserva como historial en
  // vez de borrarse. También se puede dar de baja directo con el botón
  // "Dar de baja" (ver actions/equipo-actions.ts: darDeBajaEquipo), pidiendo
  // el motivo y, si ya se sabe, por cuál equipo existente se sustituyó.
  activo     Boolean   @default(true)
  fechaBaja  DateTime?
  motivoBaja String?

  sustituidoPorId String?
  sustituidoPor   Equipo?  @relation("EquipoSustitucion", fields: [sustituidoPorId], references: [id], onDelete: SetNull)
  sustituyeA      Equipo[] @relation("EquipoSustitucion")

  // Comunes a los 3 tipos
  codigo                  String?
  nombre                  String
  categoria               String?
  tipoEquipoDetalle       String? // "Tipo de equipo": Bomba/tanque/PLC/planta de emergencia/etc, según el tipo
  marca                   String?
  modelo                  String?
  numeroSerie             String?
  fabricante              String?
  anioFabricacion         String?
  fechaInstalacion        DateTime?
  ubicacion               String?
  responsable             String?
  estado                  String? // "OPERATIVO" | "FUERA_DE_SERVICIO" | "MANTENIMIENTO"
  criticidad              String? // "ALTA" | "MEDIA" | "BAJA"
  frecuenciaMantenimiento String?
  observaciones           String?

  // Mecánico (y capacidad/potencia también se comparten con Auxiliar)
  capacidad             String?
  presionTrabajo        String?
  temperaturaOperacion  String?
  materialFabricacion   String?
  fluidoTrabajo         String?
  potencia              String?
  rpm                   String?
  lubricante            String?

  // Eléctrico / electrónico
  voltaje            String?
  corriente          String?
  frecuenciaElectrica String?
  numeroFases        String?
  proteccionIp       String?
  claseAislamiento   String?
  consumoElectrico   String?
  comunicacion       String?

  // Auxiliar
  combustible     String?
  horasOperacion  String?

  documents     Document[]
  equipmentLogs EquipmentLog[]
  // Órdenes de pieza que marcaron a este equipo como el que sustituirán
  // (ver PieceOrder.sustituyeEquipoId).
  ordenesQueLoSustituyen PieceOrder[]

  // Quién dio de alta el equipo, para la bitácora de actividad del sistema
  // (ver app/(protected)/admin/actividad).
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("equipos")
}

// Bitácora única de un Equipo (fusiona lo que antes serían bitácoras
// separadas de mecánicos y electrónicos). Se agrupa a nivel ciudad en
// lib/city-equipment-log-feed.ts, coloreada según el tipoEquipo del equipo.
model EquipmentLog {
  id String @id @default(cuid())

  equipoId String
  equipo   Equipo @relation(fields: [equipoId], references: [id], onDelete: Cascade)

  // "Preventivo" | "Correctivo" | "Predictivo" (mismo enum que MaintenanceLog)
  tipoMantenimiento String
  descripcion       String
  responsable       String?
  fecha             DateTime
  observacion       String?
  // Criticidad del equipo reportada en este mantenimiento (ver
  // lib/equipo-enums.ts: criticidadEquipoSchema). Obligatoria desde que se
  // agregó (ver actions/equipment-log-actions.ts); nula en registros
  // capturados antes. Cada vez que se crea/edita/borra un registro se
  // recalcula Equipo.criticidad a partir del más cercano a hoy.
  criticidad        String?

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("equipment_logs")
}

// PDFs adjuntos a un apartado, o a una unidad (VehicleRecord) específica dentro
// de un apartado de tipo "unidades" (vehicleRecordId presente). Solo un ADMIN
// puede subir/eliminar (validado en el server action); cualquier usuario con
// acceso a la ciudad puede descargarlos.
model Document {
  id String @id @default(cuid())

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  vehicleRecordId String?
  vehicleRecord   VehicleRecord? @relation(fields: [vehicleRecordId], references: [id], onDelete: Cascade)

  maintenanceLogId String?
  maintenanceLog   MaintenanceLog? @relation(fields: [maintenanceLogId], references: [id], onDelete: Cascade)

  ultrasoundLogId String?
  ultrasoundLog   UltrasoundLog? @relation(fields: [ultrasoundLogId], references: [id], onDelete: Cascade)

  visualInspectionLogId String?
  visualInspectionLog   VisualInspectionLog? @relation(fields: [visualInspectionLogId], references: [id], onDelete: Cascade)

  tightnessTestLogId String?
  tightnessTestLog   TightnessTestLog? @relation(fields: [tightnessTestLogId], references: [id], onDelete: Cascade)

  internalVisualInspectionLogId String?
  internalVisualInspectionLog   InternalVisualInspectionLog? @relation(fields: [internalVisualInspectionLogId], references: [id], onDelete: Cascade)

  hydrostaticTestLogId String?
  hydrostaticTestLog   HydrostaticTestLog? @relation(fields: [hydrostaticTestLogId], references: [id], onDelete: Cascade)

  extinguisherChangeLogId String?
  extinguisherChangeLog   ExtinguisherChangeLog? @relation(fields: [extinguisherChangeLogId], references: [id], onDelete: Cascade)

  valveChangeLogId String?
  valveChangeLog   ValveChangeLog? @relation(fields: [valveChangeLogId], references: [id], onDelete: Cascade)

  valveCorrectiveMaintenanceLogId String?
  valveCorrectiveMaintenanceLog   ValveCorrectiveMaintenanceLog? @relation(fields: [valveCorrectiveMaintenanceLogId], references: [id], onDelete: Cascade)

  hoseChangeLogId String?
  hoseChangeLog   HoseChangeLog? @relation(fields: [hoseChangeLogId], references: [id], onDelete: Cascade)

  equipoId String?
  equipo   Equipo? @relation(fields: [equipoId], references: [id], onDelete: Cascade)

  equipmentLogId String?
  equipmentLog   EquipmentLog? @relation(fields: [equipmentLogId], references: [id], onDelete: Cascade)

  fileName   String
  storedName String
  mimeType   String
  size       Int

  // "ADJUNTO" (PDF genérico) | "ANTES" | "DESPUES" (fotos de MaintenanceLog) |
  // "FOTO" (fotografías de Equipo tipo Auxiliar) | "PERMISO" (permiso de
  // Estación de carburación, ver UploadStationPermitForm). El resto siempre
  // queda en el valor por defecto.
  kind String @default("ADJUNTO")

  // Solo para kind "PERMISO": fecha en que se realizó/emitió el permiso
  // (distinta de createdAt, que es cuándo se subió el archivo al sistema).
  fecha DateTime?

  uploadedById String?
  uploadedBy   User?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("documents")
}

model UserCityAccess {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, cityId])
  @@map("user_city_access")
}

// Bitácora de auditoría del sistema: quién eliminó o editó qué. Se escribe
// ANTES de borrar (lib/activity-log.ts: logActivity), porque una vez que un
// registro se elimina en cascada ya no queda nada que leer para describirlo.
// userId es SetNull (igual que el resto de la app) para no perder el
// historial de auditoría si el usuario que lo generó es eliminado después;
// username guarda una copia fija del nombre en ese momento para que el
// registro siga siendo legible aunque el usuario ya no exista.
model ActivityLog {
  id       String @id @default(cuid())
  accion   String // "ELIMINAR" | "EDITAR"
  entidad  String // etiqueta legible, ej. "Registro de mantenimiento"
  resumen  String // descripción de una línea de qué se eliminó/cambió
  detalle  String?
  citySlug String?

  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  username String

  createdAt DateTime @default(now())

  @@map("activity_log")
}
